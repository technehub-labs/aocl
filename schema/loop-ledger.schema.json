{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/technehub-labs/aocl/main/schema/loop-ledger.schema.json",
  "title": "AOCL loop ledger",
  "description": "The registry of deployed/managed closed loops (the ledger the aocl-ledger CLI validates and reports on). File declares itself with top-level 'schema: 1'.",
  "type": "object",
  "required": ["schema", "loops"],
  "properties": {
    "schema": { "type": "integer", "const": 1 },
    "loops": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "entity", "entity_kind", "velocity", "level", "decision_model", "owner", "state"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "entity": { "type": "string", "minLength": 1 },
          "entity_kind": { "enum": ["process", "capability", "system", "function"] },
          "velocity": { "enum": ["fast", "tactical", "slow"] },
          "level": { "type": "integer", "minimum": 1, "maximum": 5 },
          "vector_levels": {
            "type": "object",
            "properties": {
              "GD": { "type": "integer", "minimum": 1, "maximum": 5 },
              "DV": { "type": "integer", "minimum": 1, "maximum": 5 },
              "FI": { "type": "integer", "minimum": 1, "maximum": 5 }
            },
            "additionalProperties": false
          },
          "decision_model": { "type": "string", "enum": ["OODA", "MAPE", "CUSTOM"] },
          "hitl": { "enum": ["HITL", "HOTL", "HOOTL"] },
          "state": { "enum": ["designed", "validated", "published", "active", "paused", "error", "retired"] },
          "owner": { "type": "string", "minLength": 1 },
          "guardrails": { "type": "array", "items": { "type": "string" } },
          "budget_end_to_end": { "type": "string", "description": "Latency budget per model/velocity.yaml (e.g. '< 100 ms')." },
          "last_review": { "type": "string", "format": "date" },
          "review_cadence_days": { "type": "integer", "exclusiveMinimum": 0, "default": 90 },
          "notes": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
